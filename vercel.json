{
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "installCommand": "npm install --include=dev && npm install --prefix brandmark-react --include=dev --legacy-peer-deps",
  "buildCommand": "cd brandmark-react && npm run build",
  "outputDirectory": "brandmark-react/dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "all, index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        }
      ]
    },
    {
      "source": "/(.*)\\.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    }
  ],
  "redirects": [
