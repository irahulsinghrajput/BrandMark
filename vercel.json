{
  "framework": null,
  "installCommand": "cd brandmark-react && npm install --legacy-peer-deps",
  "buildCommand": "cd brandmark-react && npm run build",
  "outputDirectory": "brandmark-react/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
